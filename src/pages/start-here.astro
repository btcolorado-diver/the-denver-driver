  {title:'I want to play more',text:'Use the time and company you have to make a round work.',href:'/play-anywhere'}]},
 {title:'Find your context',items:[
  {title:'I am planning Denver golf',text:'Use local conditions and a realistic day plan as your starting point.',href:'/denver-golf'},
  {title:'I am golfing with family',text:'Build a shared day that is welcoming for every experience level.',href:'/family-golf'},
